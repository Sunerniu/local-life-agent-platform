# 复制成 .env 后按需修改：cp .env.example .env
# docker compose 和 Spring Boot 都读这些变量（Spring 侧见 application.yaml 的 ${} 占位）
# .env 已在 .gitignore 中，密钥不会进 git

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hmdp
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 没设密码就留空
REDIS_PASSWORD=
# 项目原本就用 6 号库，保持一致
REDIS_DATABASE=6

# ---------- RabbitMQ ----------
RABBITMQ_HOST=127.0.0.1
# 5672 是 AMQP 端口（程序连这个），15672 是管理后台端口（浏览器打开）
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=hmdp
RABBITMQ_PASSWORD=123456

# ---------- 邮箱验证码（QQ 邮箱 SMTP）----------
# MAIL_PASSWORD 不是 QQ 密码，是「设置 → 账户 → POP3/SMTP服务」里生成的 16 位授权码
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 探店图片上传目录 ----------
# 默认用项目下的 nginx-1.18.0/html/hmdp/imgs。
# 注意别写成空值（HMDP_UPLOAD_DIR=），那会把默认值覆盖成空串。要自定义就取消注释并填路径。
# HMDP_UPLOAD_DIR=/Users/ergou/Code/Shop_agent/nginx-1.18.0/html/hmdp/imgs

# ---------- nginx（可选，--profile web 才用到）----------
NGINX_PORT=8080
